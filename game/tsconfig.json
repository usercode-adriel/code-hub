{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true,
    "skipLibCheck": true, "types": ["vite/client"], "isolatedModules": true
  },
  "include": ["src", "tests", "office"]
}
